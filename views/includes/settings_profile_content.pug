h2.h4.mb-4 Profile Settings

form#profile-form
	.row.align-items-center.mb-5.avatar-settings
		.col-lg-2.mb-3
			label.form-label(for="profile-avatar-style") Avatar
		.col-lg-2.mb-3
			+avatar(user.name, 'xl', user.email, user._id)
		.col-lg-8.mb-3
			h3.h6 No boring avatars
			div.text-muted.small.mb-3 Choose your avatar style from over 30 styles and shapes, and break free from avatar boredom. You and your team will all appear in this style, but only for you.
			select.form-select.form-select-sm#profile-avatar-style
				each entry in avatarStyles
					option(value=entry[0] selected=(entry[0] === (user.avatar_style || 'initials')))= entry[1]
			.avatar-picker-templates.d-none
				each entry in avatarStyles
					template(data-avatar-option=entry[0])
						div.avatar-picker-option.d-flex.align-items-center
							img.avatar.avatar-sm.me-3(src=avatarUrl(entry[0], user.email) alt="")
							span= entry[1]
							span.avatar-picker-check.ms-auto(aria-hidden="true") ✓
	.mb-3
		label.form-label.small(for="profile-name") Name
		input.form-control.form-control-sm#profile-name(type="text" value=user.name)
	.mb-3
		label.form-label.small(for="profile-email") Email
		input.form-control.form-control-sm#profile-email(type="email" value=user.email)
	.mb-3
		label.form-label.small(for="profile-timezone") Timezone
		select.form-select.form-select-sm#profile-timezone(data-timezone-select data-timezone-configured=(user.timezone_configured === true ? "true" : "false"))
			each zone in timezone_options
				option(value=zone.value selected=(user.timezone === zone.value))= zone.label
		.form-text#profile-timezone-hint
			if user.timezone === 'UTC' && user.timezone_configured !== true
				span Your browser timezone will be suggested. Save to apply it.
			else
				span Times are displayed in this timezone.
	.mb-3
		label.form-label.small(for="profile-time-format") Time format
		select.form-select.form-select-sm#profile-time-format(data-saved-time-format=(user.time_format || ""))
			option(value="12-hour" selected=(user.time_format === '12-hour')) 12-hour
			option(value="24-hour" selected=(user.time_format === '24-hour')) 24-hour
		.form-text#profile-time-format-hint
			if !user.time_format
				span Your browser clock format is suggested. Save to apply it.
			else
				span Times use this clock format.
	.d-flex.justify-content-end
		button.btn.btn-sm.btn-primary(type="submit") Save Changes
