mixin avatar(name, size, email, ownerId)
	- var seed = email || (user && user.email) || ''
	- var style = (user && user.avatar_style) || 'initials'
	img.avatar(class=`avatar-${size || 'sm'}` src=`https://ava.helpmonks.com/9.x/${style}/svg?seed=${encodeURIComponent(seed)}` alt=name title=name data-avatar-email=seed data-avatar-user-id=(ownerId || (user && user._id)) )
