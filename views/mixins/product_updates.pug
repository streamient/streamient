mixin productUpdateCard(update)
	article.card.product-update-card.mb-5(data-product-update-id=update._id)
		if update.feature_image
			img.card-img-top.product-update-card-image(src=update.feature_image alt=update.title loading="lazy")
		.card-body
			p.text-muted.small.mb-2= formatDate(update.published_at, { includeYear: true })
			h2.h3.mb-3= update.title
			p.mb-3.product-update-excerpt= update.excerpt
			a.btn.btn-sm.btn-outline-primary(href=update.link target="_blank" rel="noopener noreferrer")
				span Read more
				!= icon('openInNew', 'ms-1')
