doctype html
html(lang="en")
	head
		meta(name="csrf-token" content=csrf_token)
		script(src=`/static/v-${v}/js/csrf.js`)
		meta(charset="UTF-8")
		meta(name="viewport" content="width=device-width, initial-scale=1")
		title #{title || 'Admin — Streamient'}
		link(href='/static/images/favicon.ico' rel="shortcut icon")
		script.
			(function () {
				try {
					var t = localStorage.getItem('st-theme') || localStorage.getItem('kk-theme');
					if (t !== 'light' && t !== 'dark') t = 'light';
					document.documentElement.setAttribute('data-theme', t);
					document.documentElement.setAttribute('data-bs-theme', t);
				} catch (e) {
					document.documentElement.setAttribute('data-theme', 'light');
					document.documentElement.setAttribute('data-bs-theme', 'light');
				}
			})();
		link(href=`/static/v-${v}/css/admin_vendor.css` rel="stylesheet")
		link(href=`/static/v-${v}/css/app.css` rel="stylesheet")
		link(href=`/static/v-${v}/css/streamient-tabler.css` rel="stylesheet")
		block head
		style.
			html, body { height: 100%; }
			body { display: flex; flex-direction: column; }
			.admin-main { flex: 1; }
			.admin-footer { flex-shrink: 0; }
	body.backend-admin
		nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.sticky-top
			.container-fluid
				a.navbar-brand.ms-2(href="/admin") Streamient Admin
				.d-flex.align-items-center
					ul.navbar-nav.me-3
						block nav
							if is_hosted
								li.nav-item
									a.nav-link(href="/admin" class=(activeNav === 'accounts' ? 'active' : '')) Accounts
							li.nav-item
								a.nav-link(href="/admin/email-templates" class=(activeNav === 'email-templates' ? 'active' : '')) Email Templates
							li.nav-item
								a.nav-link(href="/admin/audit-logs" class=(activeNav === 'audit-logs' ? 'active' : '')) Audit Logs
							li.nav-item
								a.nav-link(href="/admin/settings" class=(activeNav === 'settings' ? 'active' : '')) Settings
					button.btn.btn-outline-light.btn-sm.me-3(type="button" data-admin-theme-toggle data-theme-storage-key="st-theme" data-theme-change-event="st-theme-change" aria-label="Toggle color theme" title="Toggle color theme")
						span.admin-theme-label-dark
							!= icon('darkMode', 'me-1')
							span.d-none.d-sm-inline Dark theme
						span.admin-theme-label-light
							!= icon('lightMode', 'me-1')
							span.d-none.d-sm-inline Light theme
					form(action="/admin/logout" method="POST")
						input(type="hidden" name="_csrf" value=csrf_token)
						button.btn.btn-outline-light.btn-sm(type="submit")
							!= icon('signOut', 'me-1')
							span Logout

		.container-fluid.admin-main.py-4
			block content

		.container-fluid.bg-body.admin-footer.mb-5
			.d-flex.align-items-center.justify-content-center.fs-9
				a(href="https://streamient.com?utm_source=streamient_admin&utm_medium=referral" target="_blank") Streamient
				span.ps-1 &mdash; We also make &mdash;
				a.ps-1(href="https://helpmonks.com?utm_source=streamient_admin&utm_medium=referral" target="_blank") Helpmonks
				span ,
				a.ps-1(href="https://razuna.com?utm_source=streamient_admin&utm_medium=referral" target="_blank") Razuna
				span ,
				a.ps-1(href="https://managani.com?utm_source=streamient_admin&utm_medium=referral" target="_blank") Managani
				span , and
				a.ps-1(href="https://mailtwine.com?utm_source=streamient_admin&utm_medium=referral" target="_blank") Mailtwine

		script(src=`/static/v-${v}/js/icons.js`)
		script(src=`/static/v-${v}/js/autofill_guard.js`)
		script(src=`/static/v-${v}/js/vendor.js` type="module")
		script(src=`/static/v-${v}/js/admin_theme.js`)
		block scripts
