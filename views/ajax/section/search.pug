#search-page
	form#search-form.mb-4.pb-4
		.row.align-items-center
			.col-12.col-lg-4.mb-2
				label.form-label.form-label-sm.mb-1(for="search-query") Search
				input.form-control.form-control-sm#search-query(type="search" autocomplete="off")
			.col-6.col-lg-4.mb-2
				label.form-label.form-label-sm.mb-1(for="search-project") Project
				select.form-select.form-select-sm#search-project
					option(value="") All projects
					each project in projects || []
						option(value=project._id)= project.name
			.col-6.col-lg-4.mb-2
				label.form-label.form-label-sm.mb-1(for="search-tags") Tags
				select.form-select.form-select-sm#search-tags(multiple aria-describedby="search-tag-help")
		.d-flex.align-items-center.justify-content-between.gap-3.mt-2
			.form-text.mt-0#search-tag-help Select tags or use tag:typerelay. All selected tags must match.
			button.btn.btn-primary.btn-sm.cursor-pointer#search-submit(type="submit") Search
	.d-flex.flex-wrap.align-items-center.gap-3.mb-3
		span#search-total(role="status")
		span#search-selected(role="status")
		button.btn.btn-outline-secondary.btn-sm.cursor-pointer#search-select-page(type="button") Select page
		button.btn.btn-outline-secondary.btn-sm.cursor-pointer#search-select-all(type="button") Select all matching
		button.btn.btn-link.btn-sm.cursor-pointer.d-none#search-clear(type="button") Clear selection
	.d-flex.flex-wrap.align-items-center.gap-3.mb-3
		button.btn.btn-outline-primary.btn-sm.cursor-pointer(data-search-action="move" type="button" disabled) Move project
		button.btn.btn-outline-primary.btn-sm.cursor-pointer(data-search-action="add_tags" type="button" disabled) Add tags
		button.btn.btn-outline-primary.btn-sm.cursor-pointer(data-search-action="remove_tags" type="button" disabled) Remove tags
		button.btn.btn-outline-danger.btn-sm.cursor-pointer(data-search-action="trash" type="button" disabled) Move to trash
	#search-action-status.small.mb-3(role="status")
	#search-list
	#search-empty.text-muted.mb-3.d-none No matching records.
	.d-flex.align-items-center.justify-content-end.gap-3.mb-5
		button.btn.btn-outline-secondary.btn-sm.cursor-pointer#search-prev(type="button" disabled) Previous
		span#search-page-number
		button.btn.btn-outline-secondary.btn-sm.cursor-pointer#search-next(type="button" disabled) Next
	.modal.fade#search-tags-modal(tabindex="-1" aria-labelledby="search-tags-title" aria-hidden="true")
		.modal-dialog.modal-dialog-centered
			form.modal-content#search-tags-form
				.modal-header
					h6.modal-title#search-tags-title Tags
					button.btn-close.cursor-pointer(type="button" data-bs-dismiss="modal" aria-label="Close")
				.modal-body
					p#search-tags-count
					.mb-3
						label.form-label(for="search-action-tags") Tags, one per line
						textarea.form-control.form-control-sm#search-action-tags(rows="3" required)
				.modal-footer.justify-content-between
					button.btn.btn-secondary.btn-sm.cursor-pointer(type="button" data-bs-dismiss="modal") Cancel
					button.btn.btn-primary.btn-sm.cursor-pointer(type="submit") Apply
