- const actionLabel = action === 'copy' ? 'Copy' : 'Move'
- const hasProjects = projects.length > 0

#batchProjectModal.modal.fade(tabindex="-1" aria-labelledby="batchProjectModalLabel" aria-hidden="true")
	.modal-dialog.modal-dialog-centered
		form.modal-content#batch-project-form(data-batch-action=action novalidate)
			.modal-header
				h6.modal-title#batchProjectModalLabel= `${actionLabel} to project`
				button.btn-close.cursor-pointer(type="button" data-bs-dismiss="modal" aria-label="Close")
			.modal-body
				.mb-3
					label.form-label.form-label-sm(for="batch-project-select") Project
					select.form-select.form-select-sm#batch-project-select(name="project" required disabled=!hasProjects aria-describedby=(hasProjects ? 'batch-project-validation' : 'batch-project-empty'))
						each project in projects
							option(value=project._id)= project.name
					.invalid-feedback#batch-project-validation Project required.
				if !hasProjects
					.form-text.text-warning#batch-project-empty No other projects available.
			.modal-footer.justify-content-between
				button.btn.btn-secondary.btn-sm(type="button" data-bs-dismiss="modal" data-batch-project-cancel) Cancel
				button.btn.btn-primary.btn-sm(type="submit" data-batch-project-submit disabled=!hasProjects)
					span.spinner-border.spinner-border-sm.me-2.d-none(role="status" aria-hidden="true" data-batch-project-spinner)
					span= actionLabel
