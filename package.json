    "huebee": "^2.1.1",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "jsurl2": "^2.2.0",
    "mailparser": "^3.9.24",
    "mammoth": "^1.12.2",
    "marked": "^18.0.12",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.0",
    "mongoose-lean-virtuals": "^2.1.0",
    "n-readlines": "^3.4.1",
    "nodemailer": "^10.0.3",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "striptags": "^3.2.0",
    "swagger-ui-express": "^5.0.1",
    "sweetalert2": "^11.26.25",
    "tom-select": "^2.6.2",
    "turndown": "^7.2.4",
    "typesense": "^3.0.6",
    "vitepress-openapi": "^0.2.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scarf/scarf": "^1.4.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "vue-demi": "^0.14.10"
  }
}
