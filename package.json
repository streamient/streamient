{
  "name": "streamient",
  "version": "0.1.0",
  "private": true,
  "description": "Everything your AI needs to remember — Notes, Memory, URLs, AI Chat",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": "12"
  },
  "scripts": {
    "start": "node --import ./tracing.js app.js",
    "build": "node build.js",
    "dev": "nodemon --max-old-space-size=4096 --trace-warnings --import ./tracing.js app.js",
    "test": "node --test --test-force-exit test/*.test.js test/**/*.test.js",
    "test:mcp": "node --test --test-force-exit test/mcp/**/*.test.js",
    "cli:test": "pnpm --filter @streamient/cli test",
    "cli:docs:check": "pnpm --filter @streamient/cli docs:check",
    "cli:pack": "pnpm --filter @streamient/cli pack:check",
    "cli:smoke": "pnpm --filter @streamient/cli pack:smoke",
    "android:release": "pnpm --filter @streamient/mobile android:release",
    "ios:release": "pnpm --filter @streamient/mobile ios:release",
    "trash:reconcile": "node scripts/reconcile-trash.mjs",
    "trash:migrate-ttl": "node scripts/migrate-trash-ttl-indexes.mjs",
    "docs:dev": "pnpm --filter @streamient/docs dev",
    "docs:build": "pnpm --filter @streamient/docs build",
    "docs:preview": "pnpm --filter @streamient/docs preview"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "config.js",
      "db.js",
      "routes/",
      "middleware/",
      "model/",
      "modules/",
      "services/",
      "views/",
      "src/",
      "public/css/app.css",
      "public/js/autofill_guard.js",
      "public/js/auth.js"
    ],
    "ext": "js,pug,css",
    "ignore": [
      "public/js/vendor.js",
      "public/js/editor.js",
      "public/css/admin_vendor.css"
    ],
    "exec": "node build.js && node --import ./tracing.js app.js"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.5",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@hyperdx/node-opentelemetry": "^0.11.0",
    "@iframe-resizer/child": "^5.5.9",
    "@iframe-resizer/parent": "^5.5.9",
    "@managani/cache": "0.1.5",
    "@managani/express": "^0.1.2",
    "@managani/node": "^0.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-runtime-node": "0.35.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@simplewebauthn/server": "^14.0.1",
    "@socket.io/mongo-adapter": "^0.4.0",
    "@socket.io/mongo-emitter": "^0.2.0",
    "@tabler/core": "^1.5.1",
    "@tabler/icons-webfont": "^3.46.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-code-block": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-ordered-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@yaireo/tagify": "^4.38.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cloudflare": "^7.1.0",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
